# PostgreSQL (Neon): pooled URL for the app, direct URL for prisma db push
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# JWT signing secret — generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# Optional (see DEPLOY.md)
# APP_TZ="Europe/Paris"
# SCORE_EXACT=5
# SCORE_OUTCOME=2
# SCORE_CHAMPION=10
# OPEN_FROM_PHASE="Oitavas de Final"
# NEXT_PUBLIC_ANALYTICS=1
